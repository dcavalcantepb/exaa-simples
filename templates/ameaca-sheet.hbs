<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nome da Ameaça" />
      <div class="ameaca-linha">
        <p class="ameaca-nivel">{{#if system.ambiente}}Ameaça de ambiente · {{/if}}Nível {{system.nivel}} · {{system.nivelLabel}}</p>
        <button type="button" class="ameaca-ataque-btn" data-ataque-ameaca title="Rola P dados e causa Dano igual à Letalidade">⚔ Atacar</button>
      </div>
    </div>
  </header>

  <section class="grid four-columns">
    <label title="Periculosidade: quantos dados ela rola para ferir ou prejudicar os Pilotos.">
      <span>P · Periculosidade</span>
      <select name="system.periculosidade" data-dtype="Number">
        {{#each periculosidadeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
      </select>
    </label>
    <label title="Letalidade: o Dano que causa ao acertar. Também é o seu nível.">
      <span>L · Letalidade</span>
      <select name="system.letalidade" data-dtype="Number">
        {{#each letalidadeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
      </select>
    </label>
    {{#if system.ambiente}}
    <label title="Quantas marcas são precisas para superá-la (1 a 10).">
      <span>R · Total</span>
      <input name="system.resistencia.max" type="number" min="1" max="10" value="{{system.resistencia.max}}" />
    </label>
    <div class="ameaca-status">
      <span>Superação</span>
      <p class="{{#if superada}}superada{{/if}}">{{#if superada}}Superada{{else}}{{superacaoMarcadas}} / {{system.resistencia.max}}{{/if}}</p>
    </div>
    {{else}}
    <label title="Resistência: quanto Dano ainda falta para derrotá-la.">
      <span>R · Atual</span>
      <input name="system.resistencia.value" type="number" min="0" max="10" value="{{system.resistencia.value}}" />
    </label>
    <label title="Resistência inicial da Ameaça (1 a 10).">
      <span>R · Máxima</span>
      <input name="system.resistencia.max" type="number" min="1" max="10" value="{{system.resistencia.max}}" />
    </label>
    {{/if}}
  </section>

  {{#if system.ambiente}}
  <section class="ameaca-superacao">
    <div class="checkbox-track">
      {{#each superacaoBoxes}}
        <input type="checkbox" class="superacao-box" data-index="{{@index}}" {{#if this}}checked{{/if}} />
      {{/each}}
    </div>
    <p class="ameaca-dica">Cada Sucesso dos Pilotos marca 1; um Sucesso Crítico, 2.</p>
  </section>
  {{/if}}

  <section class="ameaca-opcoes">
    <label>
      <input type="checkbox" name="system.ambiente" {{#if system.ambiente}}checked{{/if}} />
      Ameaça de ambiente (é superada, não derrotada)
    </label>
    {{#if nivel1}}
    <label>
      <input type="checkbox" name="system.metadeAbatida" {{#if system.metadeAbatida}}checked{{/if}} />
      Grupo com metade abatida: −1 de P{{#if system.grupoEnfraquecido}} (ataca com {{system.pEfetiva}}){{/if}}
    </label>
    {{/if}}
  </section>

  <section class="grid one-column">
    <section>
      <h2>Descrição</h2>
      {{editor system.notas target="system.notas" button=true owner=owner editable=editable}}
    </section>
    <label><span>Objetivo</span><textarea name="system.objetivo">{{system.objetivo}}</textarea></label>
    <section>
      <h2>Habilidade Especial</h2>
      {{editor system.habilidadeEspecial target="system.habilidadeEspecial" button=true owner=owner editable=editable}}
    </section>
    <label><span>Como age</span><textarea name="system.comoAge">{{system.comoAge}}</textarea></label>
    <label><span>Como vencer</span><textarea name="system.comoVencer">{{system.comoVencer}}</textarea></label>
  </section>
</form>
