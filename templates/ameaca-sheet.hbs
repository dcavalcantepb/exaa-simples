<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nome da Ameaça" />
    </div>
  </header>

  <section class="grid one-column">
    <div class="grid three-columns">
      <label><span>Perigo</span><input name="system.perigo" type="number" value="{{system.perigo}}" /></label>
      <label><span>Resistência Atual</span><input name="system.resistencia.value" type="number" value="{{system.resistencia.value}}" /></label>
      <label><span>Resistência Máx</span><input name="system.resistencia.max" type="number" value="{{system.resistencia.max}}" /></label>
    </div>
    <label><span>Objetivo</span><textarea name="system.objetivo">{{system.objetivo}}</textarea></label>
    <section>
      <h2>Habilidade Especial</h2>
      {{editor system.habilidadeEspecial target="system.habilidadeEspecial" button=true owner=owner editable=editable}}
    </section>
    <section>
      <h2>Notas</h2>
      {{editor system.notas target="system.notas" button=true owner=owner editable=editable}}
    </section>
  </section>
</form>