<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nome do Piloto" />
      <div class="grid three-columns">
        <div class="track-field">
          <span>EXApoints</span>
          <div class="checkbox-track">
            {{#each exapointsBoxes}}
              <input type="checkbox" class="track-checkbox" data-field="system.exapoints.value" data-index="{{@index}}" {{#if this}}checked{{/if}} />
            {{/each}}
          </div>
        </div>
        <div class="track-field">
          <span>Marcas</span>
          <div class="checkbox-track">
            {{#each sindromeBoxes}}
              <input type="checkbox" class="track-checkbox" data-field="system.sindrome.value" data-index="{{@index}}" {{#if this}}checked{{/if}} />
            {{/each}}
          </div>
        </div>
        <div class="track-field">
          <span>Protagonismo</span>
          <div class="checkbox-track">
            <input type="checkbox" class="track-checkbox" data-field="system.protagonismo" data-index="0" {{#if protagonismoChecked}}checked{{/if}} />
          </div>
        </div>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="piloto">Piloto</a>
    <a class="item" data-tab="exacom">EXACOM</a>
    <a class="item" data-tab="background">Background</a>
    <a class="item" data-tab="notas">Notas</a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="piloto">
      <section>
        <h2>Teste de Habilidade</h2>
        <div class="roll-bar">
          <label>
            <span>Atributo</span>
            <select name="roll-atributo">
              {{#each atributos as |label key|}}<option value="{{key}}">{{label}}</option>{{/each}}
            </select>
          </label>
          <label><span>Modificador</span><input name="roll-modificador" type="number" value="0" /></label>
          <label><span>EXApoints</span><input name="roll-exapoints" type="number" value="0" /></label>
        </div>
      </section>

      <section>
        <h2>Atributos</h2>
        <div class="grid four-columns">
          {{#each atributos as |label key|}}
            <label>
              <span>{{label}}</span>
              <input name="system.atributos.{{key}}.value" type="number" value="{{lookup (lookup ../system.atributos key) "value"}}" />
            </label>
          {{/each}}
        </div>
      </section>

      <section>
        <h2>Habilidades</h2>
        <div class="skills-grid">
          {{#each habilidades as |label key|}}
            <div class="skill-row">
              <button type="button" data-roll-skill="{{key}}">Rolar</button>
              <label>
                <span>{{label}}</span>
                <input name="system.habilidades.{{key}}.value" type="number" value="{{lookup (lookup ../system.habilidades key) "value"}}" />
              </label>
            </div>
          {{/each}}
        </div>
      </section>

      <section>
        <h2>Condição</h2>
        <div class="grid two-columns">
          <label><span>Dano do Piloto: {{condicaoPiloto}}</span><input name="system.dano.piloto.value" type="number" value="{{system.dano.piloto.value}}" /></label>
          <label><span>Defeito</span><input name="system.defeito" type="text" value="{{system.defeito}}" /></label>
        </div>
      </section>

      <section>
        <h2>Equipamentos</h2>
        <label class="carga-label">
          <span>Carga</span>
          <select name="system.carga">
            {{#each cargaOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
        <div class="equipamentos-grid">
          <div class="equipamento-header">
            <span>#</span>
            <span>Nome</span>
            <span>Tipo</span>
            <span>Porte</span>
          </div>
          {{#each equipamentosLista}}
            <div class="equipamento-row">
              <span>{{numero}}</span>
              <input name="system.equipamentos.{{index}}.nome" type="text" value="{{nome}}" />
              <select name="system.equipamentos.{{index}}.tipo">
                {{#each tipoOptions}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              <select name="system.equipamentos.{{index}}.porte">
                {{#each porteOptions}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
          {{/each}}
          <div class="equipamento-total">
            <span></span>
            <span></span>
            <span class="total-label">Total</span>
            <span class="total-value">{{porteTotal}}</span>
          </div>
        </div>
        {{#if cargaExcedida}}
          <p class="carga-alerta">O somatório de seus equipamentos excede a Carga escolhida. Mude sua Carga ou ajuste os seus equipamentos.</p>
        {{/if}}
      </section>
    </div>

    <div class="tab" data-group="primary" data-tab="exacom">
      <section class="grid two-columns">
        <label><span>Nome</span><input name="system.exacom.nome" type="text" value="{{system.exacom.nome}}" /></label>
        <label><span>Núcleo</span><input name="system.exacom.nucleo" type="text" value="{{system.exacom.nucleo}}" /></label>
        <label><span>Dano do EXACOM: {{condicaoEXACOM}}</span><input name="system.dano.exacom.value" type="number" value="{{system.dano.exacom.value}}" /></label>
      </section>
      <section class="grid two-columns">
        <label><span>Arma Primária</span><input name="system.exacom.armaPrimaria" type="text" value="{{system.exacom.armaPrimaria}}" /></label>
        <label><span>Arma Secundária</span><input name="system.exacom.armaSecundaria" type="text" value="{{system.exacom.armaSecundaria}}" /></label>
        <label><span>Suporte</span><input name="system.exacom.suporte" type="text" value="{{system.exacom.suporte}}" /></label>
        <label><span>Blindagem</span><input name="system.exacom.blindagem" type="text" value="{{system.exacom.blindagem}}" /></label>
      </section>
    </div>

    <div class="tab" data-group="primary" data-tab="background">
      <section class="grid three-columns">
        <label><span>Origem</span><textarea name="system.origem">{{system.origem}}</textarea></label>
        <label><span>Objetivo</span><textarea name="system.objetivo">{{system.objetivo}}</textarea></label>
        <label><span>Revés</span><textarea name="system.reves">{{system.reves}}</textarea></label>
      </section>
    </div>

    <div class="tab" data-group="primary" data-tab="notas">
      {{editor system.notas target="system.notas" button=true owner=owner editable=editable}}
    </div>
  </section>
</form>
