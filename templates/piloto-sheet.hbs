<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nome do Piloto" />
      <div class="grid three-columns">
        <div class="track-field">
          <span>EXApoints</span>
          <div class="checkbox-track">
            {{#each exapointsBoxes}}
              <input type="checkbox" class="track-checkbox" data-field="system.exapoints.value" data-index="{{@index}}" {{#if this}}checked{{/if}} />
            {{/each}}
          </div>
        </div>
        <div class="track-field">
          <span>Marcas</span>
          <div class="checkbox-track">
            {{#each sindromeBoxes}}
              <input type="checkbox" class="track-checkbox" data-field="system.sindrome.value" data-index="{{@index}}" {{#if this}}checked{{/if}} />
            {{/each}}
          </div>
        </div>
        <div class="track-field">
          <span>Protagonismo</span>
          <div class="checkbox-track">
            <input type="checkbox" class="track-checkbox" data-field="system.protagonismo" data-index="0" {{#if protagonismoChecked}}checked{{/if}} />
          </div>
        </div>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="piloto">Piloto</a>
    <a class="item" data-tab="exacom">EXACOM</a>
    <a class="item" data-tab="background">Background</a>
    <a class="item" data-tab="notas">Notas</a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="piloto">

      <div class="atributos-habilidades-grid">
        {{#each gruposHabilidades}}
        <div class="atributo-grupo">
          <div class="atributo-header">
            <span class="atributo-label">{{atributoLabel}}</span>
            <div class="stepper">
              <button type="button" class="stepper-btn" data-action="minus" data-field="system.atributos.{{atributoKey}}.value" data-max="3">−</button>
              <span class="stepper-val">{{atributoValue}}</span>
              <button type="button" class="stepper-btn" data-action="plus" data-field="system.atributos.{{atributoKey}}.value" data-max="3">+</button>
            </div>
          </div>
          <div class="habilidades-lista">
            {{#each habilidades}}
            <div class="skill-row-grupo">
              <button type="button" class="roll-btn" data-roll-skill="{{key}}">⚄</button>
              <span class="skill-nome">{{label}}</span>
              <div class="stepper stepper-sm">
                <button type="button" class="stepper-btn" data-action="minus" data-field="system.habilidades.{{key}}.value" data-max="3">−</button>
                <span class="stepper-val">{{value}}</span>
                <button type="button" class="stepper-btn" data-action="plus" data-field="system.habilidades.{{key}}.value" data-max="3">+</button>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
        {{/each}}
      </div>

      {{#unless distribuicaoValida}}
      <p class="distribuicao-erro">Distribuição de pontos incorreta. Contate seu Operador.</p>
      {{/unless}}

      <section class="secao-condicao">
        <h2>Condição</h2>
        <div class="condicao-layout">
          <div class="dano-field dano-cor-{{system.dano.piloto.value}}">
            <span class="dano-label-text">Piloto — {{condicaoPiloto}}</span>
            <div class="stepper">
              <button type="button" class="stepper-btn" data-action="minus" data-field="system.dano.piloto.value" data-max="3">−</button>
              <span class="stepper-val">{{system.dano.piloto.value}}</span>
              <button type="button" class="stepper-btn" data-action="plus" data-field="system.dano.piloto.value" data-max="3">+</button>
            </div>
          </div>
          <div class="defeito-wrapper">
            <label>
              <span>Defeito</span>
              <select name="system.defeito">
                {{#each defeitoOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </label>
            {{#if defeitoDesc}}<p class="defeito-desc">{{defeitoDesc}}</p>{{/if}}
            <label class="defeito2-toggle">
              <input type="checkbox" name="system.defeito2Ativo" {{#if defeito2Ativo}}checked{{/if}} />
              Defeito Adicional (+1 Habilidade)
            </label>
            {{#if defeito2Ativo}}
            <label>
              <span>2º Defeito</span>
              <select name="system.defeito2">
                {{#each defeito2Options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </label>
            {{#if defeito2Desc}}<p class="defeito-desc">{{defeito2Desc}}</p>{{/if}}
            {{/if}}
          </div>
        </div>
      </section>

      <section class="secao-equipamentos">
        <h2>Equipamentos</h2>
        <label class="carga-label">
          <span>Carga</span>
          <select name="system.carga">
            {{#each cargaOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
        <div class="equipamentos-grid">
          <div class="equipamento-header">
            <span>#</span>
            <span>Nome</span>
            <span>Tipo</span>
            <span>Porte</span>
          </div>
          {{#each equipamentosLista}}
            <div class="equipamento-row">
              <span>{{numero}}</span>
              <input name="system.equipamentos.{{index}}.nome" type="text" value="{{nome}}" />
              <select name="system.equipamentos.{{index}}.tipo">
                {{#each tipoOptions}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              <select name="system.equipamentos.{{index}}.porte">
                {{#each porteOptions}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
          {{/each}}
          <div class="equipamento-total">
            <span></span>
            <span></span>
            <span class="total-label">Total</span>
            <span class="total-value">{{porteTotal}}</span>
          </div>
        </div>
        {{#if cargaExcedida}}
          <p class="carga-alerta">O somatório de seus equipamentos excede a Carga escolhida. Mude sua Carga ou ajuste os seus equipamentos.</p>
        {{/if}}
      </section>
    </div>

    <div class="tab" data-group="primary" data-tab="exacom">

      <section class="grid two-columns">
        <label><span>Nome</span><input name="system.exacom.nome" type="text" value="{{system.exacom.nome}}" /></label>
        <label>
          <span>Núcleo</span>
          <select name="system.exacom.nucleo">
            {{#each nucleoOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
      </section>

      <section class="secao-condicao">
        <h2>Condição</h2>
        <div class="dano-field dano-cor-{{system.dano.exacom.value}}">
          <span class="dano-label-text">EXACOM — {{condicaoEXACOM}}</span>
          <div class="stepper">
            <button type="button" class="stepper-btn" data-action="minus" data-field="system.dano.exacom.value" data-max="3">−</button>
            <span class="stepper-val">{{system.dano.exacom.value}}</span>
            <button type="button" class="stepper-btn" data-action="plus" data-field="system.dano.exacom.value" data-max="3">+</button>
          </div>
        </div>
      </section>

      <section class="secao-modulos">
        <h2>Módulos</h2>
        <div class="modulos-grid">

          <div class="modulo-card">
            <div class="modulo-header">Arma Primária</div>
            <div class="modulo-body">
              <label><span>Nome</span><input name="system.exacom.armaPrimaria.nome" type="text" value="{{system.exacom.armaPrimaria.nome}}" /></label>
              <label>
                <span>Tipo</span>
                <select name="system.exacom.armaPrimaria.tipo">
                  {{#each armaPrimariaTipoOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
              <label>
                <span>Porte</span>
                <select name="system.exacom.armaPrimaria.porte">
                  {{#each armaPrimariaPorteOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
            </div>
          </div>

          <div class="modulo-card">
            <div class="modulo-header">Arma Secundária</div>
            <div class="modulo-body">
              <label><span>Nome</span><input name="system.exacom.armaSecundaria.nome" type="text" value="{{system.exacom.armaSecundaria.nome}}" /></label>
              <label>
                <span>Tipo</span>
                <select name="system.exacom.armaSecundaria.tipo">
                  {{#each armaSecundariaTipoOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
              <label>
                <span>Porte</span>
                <select name="system.exacom.armaSecundaria.porte">
                  {{#each armaSecundariaPorteOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
            </div>
          </div>

          <div class="modulo-card">
            <div class="modulo-header">Suporte</div>
            <div class="modulo-body">
              <label><span>Nome</span><input name="system.exacom.suporte.nome" type="text" value="{{system.exacom.suporte.nome}}" /></label>
              <label>
                <span>Categoria</span>
                <select name="system.exacom.suporte.categoria">
                  {{#each suporteCategoriaOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
            </div>
          </div>

          <div class="modulo-card">
            <div class="modulo-header">Blindagem</div>
            <div class="modulo-body">
              <label>
                <span>Porte</span>
                <select name="system.exacom.blindagem.porte">
                  {{#each blindagemPorteOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
            </div>
          </div>

        </div>
      </section>

    </div>

    <div class="tab" data-group="primary" data-tab="background">
      <section class="grid three-columns">
        <label><span>Origem</span><textarea name="system.origem">{{system.origem}}</textarea></label>
        <label><span>Objetivo</span><textarea name="system.objetivo">{{system.objetivo}}</textarea></label>
        <label><span>Revés</span><textarea name="system.reves">{{system.reves}}</textarea></label>
      </section>
    </div>

    <div class="tab" data-group="primary" data-tab="notas">
      {{editor system.notas target="system.notas" button=true owner=owner editable=editable}}
    </div>
  </section>
</form>
